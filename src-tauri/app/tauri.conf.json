{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timez Clone",
  "version": "0.1.1",
  "identifier": "com.wac.timez-clone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run tauri:prepare-service -- --release",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timez Clone",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/timez-service": "timez-service"
    },
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  }
}
